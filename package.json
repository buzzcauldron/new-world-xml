{
  "name": "nwxml",
  "version": "1.0.0",
  "description": "Visual editor for Page XML files (nwxml / New World XML)",
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "electron/main.js",
  "author": "buzzcauldron",
  "license": "MIT",
  "window": {
    "title": "New World XML",
    "width": 1200,
    "height": 800,
    "show": true,
    "min_width": 800,
    "min_height": 600
  },
  "dependencies": {
    "github-markdown-css": "^5.6.0",
    "glob": "^13.0.6",
    "image-size": "^0.6.2",
    "intercept-stdout": "^0.1.2"
  },
  "devDependencies": {
    "@electron/remote": "^2.1.3",
    "@types/jquery": "^3.3.47",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.4",
    "jshint": "^2.13.6",
    "typescript": "^5.3.3",
    "vitest": "^4.1.2"
  },
  "scripts": {
    "build": "esbuild src/entry.js --bundle --platform=node --packages=external --format=iife --outfile=js/bundle.js --log-level=info",
    "build:watch": "esbuild src/entry.js --bundle --platform=node --packages=external --format=iife --outfile=js/bundle.js --watch",
    "prepare": "npm run build",
    "review": "./scripts/code-review.sh",
    "lint": "jshint js/*.js --exclude js/*.min.js,js/bundle.js,js/xmllint.js",
    "test": "npm run review",
    "test:unit": "vitest run",
    "test:launcher": "./scripts/test-electron-launcher.sh",
    "smoke": "./scripts/smoke-electron-file-dialogs.sh",
    "typecheck": "tsc --noEmit",
    "ts": "tsc",
    "start": "electron .",
    "start:nw": "echo 'NW.js was removed on this branch; use: npm start' >&2; exit 1",
    "verify:electron": "./scripts/verify-electron.sh",
    "test:install-docker": "./scripts/test-install-docker.sh",
    "test:install-mac": "./scripts/test-fresh-install-mac.sh",
    "install-desktop": "./scripts/install-desktop.sh",
    "docker:run": "./docker-run.sh",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "build": {
    "appId": "com.buzzcauldron.newworldxml",
    "productName": "New World XML",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*.js",
      "html/**/*",
      "js/**/*",
      "css/**/*",
      "src/**/*",
      "plugins/**/*",
      "xsd/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/buzzcauldron/new-world-xml.git"
  },
  "keywords": [
    "nwxml",
    "page-xml",
    "document-editor",
    "annotation-tool",
    "visual-editor",
    "new-world-xml"
  ]
}
