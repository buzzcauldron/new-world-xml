#!/usr/bin/env bash
# Launcher for nwxml (New World XML, Electron). Passes optional file paths to the app.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

ELECTRON="${ROOT}/node_modules/.bin/electron"
if [ -f "$ELECTRON" ] && [ ! -x "$ELECTRON" ]; then
  chmod +x "$ELECTRON" 2>/dev/null || true
fi

if [ ! -f "$ELECTRON" ]; then
  echo "error: Electron CLI not found at node_modules/.bin/electron — run: npm ci" >&2
  exit 1
fi

exec "$ELECTRON" "$ROOT" "$@"
